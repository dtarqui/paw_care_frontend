# URL base del backend. En local apunta al servidor de desarrollo; en producción
# (Vercel) configúrala como variable de entorno del proyecto apuntando a la URL
# desplegada del backend — Vite la incrusta en el build, así que un cambio acá
# requiere un nuevo build/deploy, no solo reiniciar el servidor.
VITE_API_URL=http://localhost:4000
